# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored.

# Hostname(s) the site is served on. DNS must point at this server before
# the first start, or Let's Encrypt can't issue the certificate.
# Several hostnames: separate with a comma, e.g. "openkerk.com, www.openkerk.com".
DOMAIN=openkerk.com

# Let's Encrypt account email (used for certificate expiry/problem notices).
ACME_EMAIL=contact@openkerk.com

# SECRET_KEY (Flask session signing) is generated here by update.sh on its
# first run; leave it alone afterwards.

